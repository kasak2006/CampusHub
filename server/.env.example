# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS / Socket.io
CLIENT_ORIGIN=http://localhost:5173

# ─── Database ─────────────────────────────────────────────
# Atlas free tier is fine. Example:
# mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/campushub
MONGO_URI=mongodb://127.0.0.1:27017/campushub

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── Single-college scoping (see 01-project-overview.md §4) ─
# Hardcoded today; every record still carries a collegeId so
# multi-college can be added later without a rewrite.
DEFAULT_COLLEGE_ID=campushub-main

# ─── Cloudinary (file storage) ────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
